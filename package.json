{
  "name": "@caffeine/template-app",
  "type": "module",
  "workspaces": [
    "src/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@caffeine/template-frontend",
    "build": "npm run build --workspace=@caffeine/template-frontend && mkdir -p dist && cp -r src/frontend/dist/. dist/ 2>/dev/null || true",
    "lint": "npm run typecheck",
    "typecheck": "npm run typecheck --workspace=@caffeine/template-frontend"
  },
  "devDependencies": {
    "sharp": "^0.34.4"
  }
}
